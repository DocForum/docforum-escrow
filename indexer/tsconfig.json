{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"]
  },
  "ts-node": {
    "transpileOnly": true,
    "moduleTypes": {
      "**/*.ts": "cjs"
    }
  },
  "include": ["src/**/*.ts"]
}
