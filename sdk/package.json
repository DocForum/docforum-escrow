{
  "name": "@docforum/escrow-sdk",
  "version": "0.5.0",
  "description": "TypeScript client for the docforum-escrow Soroban contract.",
  "type": "module",
  "main": "dist/cjs/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build:esm && npm run build:cjs",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:fixtures": "vitest run tests/events.test.ts",
    "test:unit": "vitest run tests/fees.test.ts",
    "test:offline": "vitest run tests/events.test.ts tests/quorum-validation.test.ts",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node tests/runtime-smoke.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "smoke:cjs": "node smoke/cjs.cjs",
    "smoke:esm": "node smoke/esm.mjs",
    "smoke:browser": "vite build --config smoke/browser/vite.config.mjs",
    "smoke": "npm run smoke:cjs && npm run smoke:esm && npm run smoke:browser"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "module": "dist/esm/index.js",
  "browser": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "browser": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  }
}
