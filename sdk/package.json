{
  "name": "@docforum/escrow-sdk",
  "version": "0.5.0",
  "description": "TypeScript client for the docforum-escrow Soroban contract.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "test": "vitest run --exclude '**/testnet-integration.test.ts'",
    "test:integration": "vitest run",
    "test:fixtures": "vitest run tests/events.test.ts",
    "test:unit": "vitest run tests/fees.test.ts",
    "test:offline": "vitest run tests/events.test.ts tests/quorum-validation.test.ts",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node tests/runtime-smoke.mjs",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  }
}