{
  "name": "@docforum/escrow-sdk",
  "version": "0.4.0",
  "description": "TypeScript client for the docforum-escrow Soroban contract.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "test": "vitest run --exclude '**/testnet-integration.test.ts'",
    "test:integration": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
