{
  "name": "@docforum/escrow-sdk",
  "version": "0.7.0",
  "description": "TypeScript client for the docforum-escrow Soroban contract.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signers/wallets-kit": {
      "types": "./dist/signers/wallets-kit.d.ts",
      "import": "./dist/signers/wallets-kit.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:fixtures": "vitest run tests/events.test.ts",
    "test:milestones": "vitest run tests/milestones.test.ts",
    "test:unit": "vitest run tests/fees.test.ts tests/signers.test.ts",
    "test:instrumentation": "vitest run tests/instrumentation.test.ts",
    "test:offline": "vitest run tests/events.test.ts tests/quorum-validation.test.ts tests/pooled-validation.test.ts tests/instrumentation.test.ts tests/signers.test.ts tests/relayed.test.ts tests/escrow-data.test.ts tests/factory.test.ts",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node tests/runtime-smoke.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:futurenet": "vitest run --config vitest.futurenet.config.ts",
    "test:factory": "vitest run tests/factory.test.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1"
  },
  "peerDependencies": {
    "@creit.tech/stellar-wallets-kit": ">=1.0.0 <3",
    "@opentelemetry/api": ">=1.7.0"
  },
  "peerDependenciesMeta": {
    "@creit.tech/stellar-wallets-kit": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}