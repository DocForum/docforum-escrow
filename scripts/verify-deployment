#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || -z "$1" ]]; then
  echo "Usage: scripts/verify-deployment <contract-id>" >&2
  exit 2
fi

contract_id="$1"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cli_version="$(sed -n 's/^version=//p' "$repo_root/scripts/stellar-cli-version")"
actual_cli_version="$(stellar --version | awk 'NR == 1 { print $2 }' | sed 's/^v//')"
if [[ "$actual_cli_version" != "$cli_version" ]]; then
  echo "Expected Stellar CLI $cli_version, found $actual_cli_version." >&2
  exit 2
fi

temp_root="$(mktemp -d "${TMPDIR:-/tmp}/escrow deployment verify.XXXXXX")"
trap 'rm -rf "$temp_root"' EXIT
on_chain_wasm="$temp_root/on-chain.wasm"

bash "$repo_root/scripts/build-wasm.sh"
local_wasm="$repo_root/contracts/escrow/target/wasm32v1-none/release/docforum_escrow.wasm"

stellar contract fetch \
  --config-dir "$temp_root/stellar-config" \
  --id "$contract_id" \
  --network testnet \
  --out-file "$on_chain_wasm"

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
  else
    shasum -a 256 "$1" | cut -d ' ' -f 1
  fi
}

local_hash="$(hash_file "$local_wasm")"
on_chain_hash="$(hash_file "$on_chain_wasm")"
printf 'Local build SHA-256: %s\nOn-chain SHA-256:    %s\n' "$local_hash" "$on_chain_hash"
if [[ "$local_hash" != "$on_chain_hash" ]]; then
  echo "FAIL: deployed WASM does not match this source build (testnet)." >&2
  exit 1
fi
echo "PASS: deployed WASM matches this source build (testnet)."
