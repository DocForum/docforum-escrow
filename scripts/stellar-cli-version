# Pinned Stellar CLI used for generated bindings and deployment verification.
#
# Generator output is only comparable across runs of the *same* CLI version, so
# the CI bindings check (issue #121) and scripts/check-generated-bindings.sh
# both read this file. Bumping it is an intentional change: update the version
# and checksum, regenerate the bindings with the new CLI, and commit both.
version=28.1.0
# sha256 of the Linux release tarballs (CI uses x86_64; the devcontainer also
# supports aarch64 on Apple Silicon).
