{
  "name": "@docforum/escrow-react",
  "version": "0.1.0",
  "description": "React hooks for docforum-escrow state, actions and timeline (no UI).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@docforum/escrow-sdk": ">=0.6.0 <1",
    "@tanstack/react-query": ">=5.0.0 <6",
    "react": ">=18.0.0 <20"
  },
  "peerDependenciesMeta": {
    "@docforum/escrow-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
